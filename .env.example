NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# the Publishable key (sb_publishable_...). Legacy projects: the anon key in NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
NEXT_PUBLIC_APP_NAME=لوحة المبيعات
NEXT_PUBLIC_TIMEZONE=Africa/Cairo
NEXT_PUBLIC_CURRENCY=EGP
# the bot username WITHOUT @ (builds the rep invite link  https://t.me/<bot>?start=<CODE>)
NEXT_PUBLIC_BOT_USERNAME=your_bot_username
# SERVER ONLY (Vercel -> Environment Variables, type Secret). Used by /api/rep-account and /api/companies
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
